### Running mode compose file ###
COMPOSE_PATH_SEPARATOR=:
# Logging traffic and directly visualizing it (development mode)
COMPOSE_FILE=docker-compose.yml:docker-compose.live.yml:docker-compose.visualize.yml

# Logging traffic to (encrypted) files (production mode)
# COMPOSE_FILE=docker-compose.yml:docker-compose.encrypt.yml

# Logging traffic to (encrypted) files and directly visualizing it (single-host)
# COMPOSE_FILE=docker-compose.yml:docker-compose.live.yml:docker-compose.visualize.yml:docker-compose.encrypt.yml

# Visualizing (encrypted) logs from files (running visualization stack only)
# COMPOSE_FILE=docker-compose.visualize.yml

# Running a remote visualization stack (visualization-host)
# COMPOSE_FILE=docker-compose.yml:docker-compose.visualize.yml

# Sending logs to a remote visualization and logging stack (application-host)
# COMPOSE_FILE=docker-compose.yml:docker-compose.live.yml:docker-compose.encrypt.yml

### Security ###
# Passwords in this section must be at least 6 characters long, alphanumeric, and can’t contain special characters
# Password for the 'elastic' built-in user
ELASTIC_PASSWORD=changeme

# Password for the 'kibana_system' built-in user
KIBANA_PASSWORD=changeme

# Password for the 'logstash_internal' user
LOGSTASH_PASSWORD=changeme

### Host Configuration ###
# For single-host local deployment, use the Docker service name:
ELASTIC_HOST=elasticsearch

# For remote elasticsearch deployment, use the IP or domain:
# ELASTIC_HOST=198.51.100.20
# ELASTIC_HOST=es.example.com
